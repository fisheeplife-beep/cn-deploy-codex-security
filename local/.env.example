# Lab credentials for Compose / CLI. Copy to local/.env and chmod 600.
# Never commit this file (local/.env is gitignored).

# Prefer environment keys for unattended / CI runs. Do not paste keys into
# command-line arguments (they end up in shell history and process lists).
# OPENAI_API_KEY=
# CODEX_API_KEY=

# Private Git checkouts inside the container (optional).
# GH_TOKEN=
# GITHUB_TOKEN=
# CODEX_SECURITY_GIT_HOST=

# Optional other providers (see upstream CLI docs). Unused unless you select them.
# OPENROUTER_API_KEY=
# FIREWORKS_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=
