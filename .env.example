# Companion script pins / overrides. No production secrets in this file.
# Copy to .env if you need local overrides (already gitignored).

CODEX_SECURITY_TAG=npm-v0.9.1
CODEX_SECURITY_COMMIT=fe1089ab514599931ff0ce77a82dc8c4a99201ea
CODEX_SECURITY_NPM=0.9.1
CODEX_SECURITY_DEST=data/upstream-codex-security

# Prefer a digest over floating "latest". As of 2026-11-12, :0.9.1 and :latest
# both resolved to this multi-arch Debian index digest.
CODEX_SECURITY_IMAGE=ghcr.io/openai/codex-security:0.9.1
CODEX_SECURITY_IMAGE_DIGEST=sha256:947961462b918b4fa830d89772971b9a4d1423c79bd5489d5a2b33d4c6dd9037

# Host bind mounts for Compose (must already exist; create_host_path is false).
CODEX_SECURITY_RESULTS=data/lab/results
CODEX_SECURITY_STATE=data/lab/state
CODEX_SECURITY_CSV=examples/repositories.csv.example

# npm local prefix for path B (avoids a global install).
CODEX_SECURITY_NPM_PREFIX=data/npm-prefix

# Put real keys in local/.env only — never commit them:
# OPENAI_API_KEY=
# CODEX_API_KEY=
# GH_TOKEN=
# GITHUB_TOKEN=
